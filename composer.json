{
    "name": "danog/php-rtc-stats",
    "type": "library",
    "description": "WebRTC statistics objects for RTP, DTLS, ICE, and media metrics. MadelineProto's PHP 8.2+ fork supports the modular danog/php-rtc stack.",
    "keywords": [
        "webrtc",
        "stats"
    ],
    "homepage": "https://www.quasarstream.com/webrtc",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Amin Yazdanpanah",
            "email": "github@aminyazdanpanah.com"
        },
        {
            "name": "Sana Moniri",
            "email": "s.mo@quasarstream.com"
        },
        {
            "name": "Quasar Stream Community",
            "homepage": "https://quasarstream.com/teams"
        }
    ],
    "require": {
        "php": "^8.2",
        "quasarstream/mixin": "^v1.0",
        "quasarstream/ice": "^v1.0"
    },
    "autoload": {
        "psr-4": {
            "Webrtc\\Stats\\": "src"
        }
    },
    "minimum-stability": "dev",
    "replace": {
        "quasarstream/stats": "self.version"
    }
}
