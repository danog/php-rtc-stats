{
    "name": "danog/php-rtc-stats",
    "type": "library",
    "description": "WebRTC statistics objects for RTP, DTLS, ICE, and media metrics. MadelineProto's PHP 8.2+ fork supports the modular danog/php-rtc stack.",
    "keywords": [
        "webrtc",
        "stats"
    ],
    "homepage": "https://github.com/danog/php-rtc-stats",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Amin Yazdanpanah",
            "email": "github@aminyazdanpanah.com"
        },
        {
            "name": "Sana Moniri",
            "email": "s.mo@quasarstream.com"
        },
        {
            "name": "Quasar Stream Community"
        },
        {
            "name": "Daniil Gentili",
            "email": "daniil@daniil.it"
        }
    ],
    "require": {
        "php": "^8.2",
        "danog/php-rtc-mixin": "^v1.0",
        "danog/php-rtc-ice": "^v1.0"
    },
    "autoload": {
        "psr-4": {
            "Webrtc\\Stats\\": "src"
        }
    },
    "minimum-stability": "stable"
}
